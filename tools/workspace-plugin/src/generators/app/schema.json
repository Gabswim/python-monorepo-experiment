{
  "$schema": "https://json-schema.org/schema",
  "$id": "App",
  "title": "Create a Python application",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Application name (e.g. my-app)",
      "$default": {
        "$source": "argv",
        "index": 0
      },
      "x-prompt": "What name would you like to use for the application?"
    }
  },
  "required": ["name"]
}
